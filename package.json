{
  "name": "vscode-codex-usage",
  "displayName": "Codex Usage",
  "description": "Show Codex CLI usage in the VS Code status bar.",
  "version": "0.2.0",
  "publisher": "ganymede404",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0E1117",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ganymede404/vscode-codex-usage.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI", "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "codex-logo": {
        "description": "Codex logo",
        "default": {
          "fontPath": "./icons/codex-icon.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "commands": [
      {
        "command": "codexUsage.refresh",
        "title": "Codex Usage: Refresh"
      },
      {
        "command": "codexUsage.showUsage",
        "title": "Codex Usage: Show Usage"
      },
      {
        "command": "codexUsage.showMoreInformation",
        "title": "Codex Usage: Show More Information"
      },
      {
        "command": "codexUsage.openSessionsFolder",
        "title": "Codex Usage: Open Sessions Folder"
      }
    ],
    "configuration": {
      "title": "Codex Usage",
      "properties": {
        "codexUsage.source": {
          "type": "string",
          "enum": ["auto", "api", "rollout"],
          "enumDescriptions": [
            "Query the Codex API when logged in, otherwise read local rollout files.",
            "Always query the Codex API using the logged-in credential (falls back to rollout files if the query fails).",
            "Always read local rollout files (offline)."
          ],
          "default": "auto",
          "description": "Where usage data comes from: live Codex API (online) or local rollout files (offline)."
        },
        "codexUsage.compactStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show a compact status bar chip (icon + single percent) instead of the full per-window breakdown."
        },
        "codexUsage.codexHome": {
          "type": "string",
          "default": "",
          "description": "Path to the Codex home directory. Empty means use ~/.codex."
        },
        "codexUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "How often to re-read the latest rollout file, in seconds."
        },
        "codexUsage.lookbackDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "How many days back to search for rollout files."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
